<Window x:Class="VideoPlayer.DahuaStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Kamery i Rejestratory IP Dahua — Strumienie Live &amp; Archiwum"
        Width="1280" Height="840" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117" Foreground="#F8FAFC" FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- Przyciski ogólne -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292E39" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#525C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3B4455" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7A879E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1F232B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kafelki szybkiego wyboru kanału z nazwą -->
        <Style x:Key="ChannelButton" TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#252A36" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#525C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChBorder" Property="Background" Value="#384357" />
                                <Setter TargetName="ChBorder" Property="BorderBrush" Value="#93A3BF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kafelki presetów PTZ -->
        <Style x:Key="PresetTileButton" TargetType="Button" BasedOn="{StaticResource ChannelButton}">
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#16A34A" />
            <Setter Property="BorderBrush" Value="#22C55E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Pola tekstowe i hasła o wysokim kontraście -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161922" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#525C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#161922" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#525C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <!-- ComboBox o wysokim kontraście -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202532" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#5B667A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="Background" Value="#202532" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#16A34A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="#202532" BorderBrush="#5B667A" BorderThickness="1" CornerRadius="6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="#FFFFFF" TextElement.FontWeight="SemiBold" RecognizesAccessKey="True" />
                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#CBD5E1" Width="8" Height="4" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0" Opacity="0.01" />
                            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1A1E29" BorderBrush="#5B667A" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="300">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker o wysokim kontraście -->
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#161922" />
            <Setter Property="BorderBrush" Value="#5B667A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#161922" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Etykiety pól -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pasek górny / Nagłówek -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#16A34A" CornerRadius="4" Padding="7,3" Margin="0,0,10,0">
                    <TextBlock Text="DAHUA NetSDK" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text="Kamery i Rejestratory IP Dahua — Podgląd Live &amp; Archiwum nagrań" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="#F8FAFC" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zamknij okno" Click="Close_Click" Padding="14,6" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Główna zawartość -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="430" MinWidth="370" />
            </Grid.ColumnDefinitions>

            <!-- Lewa strona: Ekran Wideo + Pasek kanałów -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Ekran wideo -->
                <Border Grid.Row="0" Background="#000000" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid x:Name="VideoContainerGrid">
                        <wfi:WindowsFormsHost x:Name="PrimaryVideoHost" Background="#000000" />
                        <Border x:Name="StreamOverlay" Background="#B0000000" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" Padding="22">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="OverlayText" Text="Brak aktywnego strumienia" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Wybierz urządzenie i kliknij 'Połącz ze strumieniem'" Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Etykieta aktywnego kanału i nazwy na ekranie -->
                        <Border Background="#E0000000" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveIndicator" Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="ActiveChannelOverlayText" Text="BRAMA GŁÓWNA (CH 1)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Pasek szybkiego wyboru kanałów po nazwie -->
                <Border Grid.Row="1" Background="#161A23" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="PRZEŁĄCZANIE KANAŁÓW PO NAZWIE:" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Inny kanał:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="CustomChannelBox" Text="1" Width="44" TextAlignment="Center" Padding="2" FontWeight="Bold" Foreground="#FFFFFF" Background="#202532" BorderBrush="#5B667A" />
                                <Button Content="Przełącz" Click="CustomChannel_Click" Padding="10,2" Margin="4,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="ChannelButtonsPanel">
                            <!-- Kafelki z nazwami kanałów generowane w C# -->
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Prawa strona: Panel narzędzi (Strumień Live / Presety PTZ / Archiwum) -->
            <Border Grid.Column="1" Background="#1A1E28" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="6" Padding="10">
                <TabControl Background="#1A1E28" BorderThickness="0" Padding="4">
                    <!-- ZAKŁADKA 1: Podgląd na żywo, nazwy kanałów & PTZ z Presetami -->
                    <TabItem Header="Strumień Na Żywo &amp; PTZ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <StackPanel>
                                <TextBlock Text="ZAPISANE KAMERY I REJESTRATORY DAHUA" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                                <ListBox x:Name="DevicesListBox" Height="110" Background="#13161F" Foreground="#FFFFFF" BorderBrush="#4A5568" Margin="0,0,0,8" SelectionChanged="DevicesListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Formularz edycji nazwy i parametrów urządzenia -->
                                <Border Background="#161922" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PARAMETRY WYBRANEGO URZĄDZENIA" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,6" />

                                        <TextBlock Text="Nazwa urządzenia (widoczna dla operatora):" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="DeviceCustomNameBox" Text="Rejestrator NVR Dahua (8 kanałów)" FontWeight="Bold" Margin="0,0,0,6" ToolTip="Wpisz dowolną nazwę kamery/rejestratora (np. Rejestrator Hala Magazynowa, Kamera Brama)" />

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Adres IP:" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DeviceIpBox" Text="192.168.1.200" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Port:" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DevicePortBox" Text="37777" TextAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Użytkownik:" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="DeviceUserBox" Text="admin" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Hasło:" Style="{StaticResource FieldLabel}" />
                                                <PasswordBox x:Name="DevicePassBox" />
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel>
                                            <Button Content="💾 Zapisz nazwę / dane" Click="SaveDevice_Click" Style="{StaticResource BlueButton}" Padding="10,5" ToolTip="Zapisuje zmienioną nazwę i parametry dla operatora" />
                                            <Button Content="➕ Dodaj jako nowe" Click="AddDevice_Click" Padding="10,5" ToolTip="Dodaje nowe urządzenie z podaną nazwą do listy" />
                                            <Button Content="🗑 Usuń" Click="DeleteDevice_Click" Padding="10,5" ToolTip="Usuwa wybrane urządzenie z listy" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="ConnectButton" Content="▶ Połącz ze strumieniem" Click="Connect_Click" Style="{StaticResource GreenButton}" />
                                    <Button x:Name="DisconnectButton" Content="■ Rozłącz" Click="Disconnect_Click" Style="{StaticResource RedButton}" IsEnabled="False" />
                                    <Button x:Name="QueryDeviceButton" Content="🔄 Odczytaj z kamery / NVR" Click="QueryFromDevice_Click" Style="{StaticResource BlueButton}" ToolTip="Pobiera nazwy kanałów i presety PTZ bezpośrednio z podłączonego urządzenia" />
                                </WrapPanel>

                                <!-- Wybór kanału po zapisanej nazwie -->
                                <TextBlock Text="WYBÓR KANAŁU PO NAZWIE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ChannelComboBox" SelectedIndex="0" SelectionChanged="ChannelComboBox_SelectionChanged" Margin="0,0,6,0">
                                        <!-- Elementy z nazwami kanałów -->
                                    </ComboBox>
                                    <ComboBox x:Name="StreamTypeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="StreamTypeBox_SelectionChanged">
                                        <ComboBoxItem Content="Główny (Main - HD)" />
                                        <ComboBoxItem Content="Podstrumień (Sub - Płynny)" />
                                    </ComboBox>
                                </Grid>

                                <!-- Edycja nazwy aktywnego kanału -->
                                <TextBlock Text="EDYTUJ NAZWĘ BIEŻĄCEGO KANAŁU" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChannelNameEditBox" Text="Brama główna" FontWeight="Bold" Margin="0,0,6,0" ToolTip="Wpisz własną nazwę kamery (np. Wjazd, Rampa, Magazyn)" />
                                    <Button Grid.Column="1" Content="Zapisz nazwę" Click="SaveChannelName_Click" Padding="12,5" Margin="0" />
                                </Grid>

                                <!-- Narzędzia i OCR ze strumienia Live -->
                                <TextBlock Text="ANALIZA ZE STRUMIENIA NA ŻYWO" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Zapisz klatkę (JPG)" Click="Snapshot_Click" />
                                    <Button Content="Rozpoznaj tablicę (OCR)" Click="OcrFromLive_Click" Style="{StaticResource BlueButton}" ToolTip="Zatrzymaj klatkę i rozpoznaj tablicę lokalnym modułem OCR" />
                                </WrapPanel>

                                <!-- SEKCJA PTZ: PRESETY (WCZYTYWANIE ZAPISANYCH POZYCJI PTZ) -->
                                <TextBlock Text="ZAPISANE POZYCJE PTZ (PRESETY)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PresetsComboBox" Margin="0,0,6,0" SelectedIndex="0">
                                        <!-- Presety z nazwami -->
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="▶ Idź do presetu" Click="GotoPreset_Click" Style="{StaticResource GreenButton}" Padding="12,6" Margin="0" ToolTip="Obraca kamerę do wybranej pozycji" />
                                </Grid>

                                <!-- Szybkie kafelki presetów -->
                                <WrapPanel x:Name="QuickPresetsPanel" Margin="0,0,0,8">
                                    <!-- Dynamiczne kafelki [P1: Brama] [P2: Szlaban] ... -->
                                </WrapPanel>

                                <!-- Panel dodawania nowego presetu -->
                                <Expander Header="Zapisz bieżącą pozycję jako preset PTZ" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10">
                                    <Border Background="#161922" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Nr presetu" FontSize="10" Foreground="#CBD5E1" Margin="0,0,0,2" />
                                                    <TextBox x:Name="PresetNumberBox" Text="1" TextAlignment="Center" FontWeight="Bold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Nazwa punktu" FontSize="10" Foreground="#CBD5E1" Margin="0,0,0,2" />
                                                    <TextBox x:Name="PresetNameBox" Text="Brama wjazdowa (Szeroki kąt)" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel>
                                                <Button Content="💾 Zapisz bieżącą pozycję" Click="SaveCurrentPositionAsPreset_Click" Style="{StaticResource BlueButton}" Padding="10,5" />
                                                <Button Content="Usuń preset" Click="DeletePreset_Click" Padding="10,5" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- Sterowanie ręczne obrotem PTZ -->
                                <TextBlock Text="RĘCZNE STEROWANIE OBROTEM PTZ" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <Grid Width="160" Height="90" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" Content="▲" PreviewMouseDown="PtzUp_Down" PreviewMouseUp="Ptz_Stop" Margin="2" Padding="0"  Tag="UP"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="◀" PreviewMouseDown="PtzLeft_Down" PreviewMouseUp="Ptz_Stop" Margin="2" Padding="0"  Tag="LEFT"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="▶" PreviewMouseDown="PtzRight_Down" PreviewMouseUp="Ptz_Stop" Margin="2" Padding="0"  Tag="RIGHT"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="▼" PreviewMouseDown="PtzDown_Down" PreviewMouseUp="Ptz_Stop" Margin="2" Padding="0"  Tag="DOWN"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Zoom +" PreviewMouseDown="PtzZoomIn_Down" PreviewMouseUp="Ptz_Stop" Padding="10,5"  Tag="ZOOM_IN"/>
                                    <Button Content="Zoom -" PreviewMouseDown="PtzZoomOut_Down" PreviewMouseUp="Ptz_Stop" Padding="10,5"  Tag="ZOOM_OUT"/>
                                    <Button Content="Focus +" PreviewMouseDown="PtzFocusIn_Down" PreviewMouseUp="Ptz_Stop" Padding="10,5"  Tag="FOCUS_IN"/>
                                    <Button Content="Focus -" PreviewMouseDown="PtzFocusOut_Down" PreviewMouseUp="Ptz_Stop" Padding="10,5"  Tag="FOCUS_OUT"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ZAKŁADKA 2: Wczytywanie nagrania wg nazwy kanału i dat do GŁÓWNEGO ODTWARZACZA -->
                    <TabItem Header="Archiwum wg Daty (Pełny Odtwarzacz)">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <StackPanel>
                                <Border Background="#166534" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,14">
                                    <StackPanel>
                                        <TextBlock Text="WCZYTYWANIE NAGRANIA DO GŁÓWNEGO ODTWARZACZA" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                        <TextBlock Text="Pobierz nagranie z rejestratora wg nazwy kanału i daty. Załaduje się ono do głównego okna VideoPlayer z dostępem do: osi czasu, klatkowania strzałkami, OCR tablic, cięcia i eksportu PDF/CSV!" Foreground="#DCFCE7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="WYBÓR KANAŁU KAMERY (WG NAZWY)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <ComboBox x:Name="ArchiveChannelBox" SelectedIndex="0" Margin="0,0,0,12">
                                    <!-- Dynamicznie wypełniane z nazwami: Brama wjazdowa (CH 1), itd. -->
                                </ComboBox>

                                <TextBlock Text="POCZĄTEK ZAKRESU (OD)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="StartDatePicker" Grid.Column="0" Margin="0,0,6,0" />
                                    <TextBox x:Name="StartTimeBox" Grid.Column="1" Text="12:00:00" ToolTip="Godzina:Minuta:Sekunda (np. 14:30:00)" FontWeight="Bold" />
                                </Grid>

                                <TextBlock Text="KONIEC ZAKRESU (DO)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="EndDatePicker" Grid.Column="0" Margin="0,0,6,0" />
                                    <TextBox x:Name="EndTimeBox" Grid.Column="1" Text="12:15:00" ToolTip="Godzina:Minuta:Sekunda (np. 14:45:00)" FontWeight="Bold" />
                                </Grid>

                                <Button x:Name="SearchArchiveButton" Content="🔎 Wyszukaj nagrania na rejestratorze" Click="SearchArchive_Click" Style="{StaticResource BlueButton}" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                                <TextBlock Text="NAGRANIA ZNALEZIONE NA URZĄDZENIU" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <DataGrid x:Name="ArchiveRecordsGrid" Height="190" AutoGenerateColumns="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="#13161F" Foreground="#E2E8F0"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Początek" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="*" />
                                        <DataGridTextColumn Header="Koniec" Binding="{Binding EndTime, StringFormat={}{0:HH:mm:ss}}" Width="85" />
                                        <DataGridTextColumn Header="Czas" Binding="{Binding DurationText}" Width="70" />
                                        <DataGridTextColumn Header="Rozmiar" Binding="{Binding SizeText}" Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="▶ Odtwórz zaznaczone w oknie Dahua" Click="PlaySelectedRecord_Click" Margin="0,0,6,6" />
                                    <Button Content="★ Wczytaj zaznaczone do głównego odtwarzacza" Click="LoadSelectedRecord_Click" Style="{StaticResource GreenButton}" Margin="0,0,0,6" />
                                </WrapPanel>

                                <ProgressBar x:Name="DownloadProgressBar" Height="8" Margin="0,0,0,8" Visibility="Collapsed" Background="#13161F" Foreground="#22C55E" />
                                <TextBlock x:Name="DownloadStatusText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                                <Button x:Name="LoadToPlayerButton" Content="★ Wczytaj nagranie do Głównego Odtwarzacza" Click="LoadToPlayer_Click" Style="{StaticResource GreenButton}" Padding="14,10" Margin="0,0,0,10" HorizontalAlignment="Stretch" ToolTip="Pobiera fragment i otwiera go w głównym oknie ze wszystkimi narzędziami" />

                                <Button Content="Podgląd tego zakresu w oknie Dahua" Click="PlayArchiveInWindow_Click" Margin="0,0,0,10" HorizontalAlignment="Stretch" />

                                <Border Background="#13161F" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                                    <TextBlock Text="Dostępne narzędzia w odtwarzaczu po załadowaniu:&#x0a;• Pełna oś czasu z czasem i przewijaniem&#x0a;• Klatkowanie strzałkami w przód i w tył (klatka po klatce)&#x0a;• Powiększanie kółkiem myszy (Zoom &amp; Pan)&#x0a;• Wycinanie fragmentów (I / O) i eksport MP4&#x0a;• Lokalne rozpoznawanie tablic OCR (Tesseract)&#x0a;• Raporty PDF i CSV ze zdarzeń" Foreground="#E2E8F0" FontSize="11" LineHeight="18" FontWeight="Medium" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Dolny pasek stanu -->
        <Border Grid.Row="2" Background="#13161F" BorderBrush="#3B4455" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="SdkStatusBadge" Text="Dahua NetSDK: Sprawdzanie…" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Text="Gotowy do połączenia ze strumieniem IP." Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
