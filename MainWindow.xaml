<Window x:Class="VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Odtwarzacz wideo"
        Width="1200"
        Height="780"
        MinWidth="850"
        MinHeight="520"
        Background="#111318"
        Foreground="#F1F3F5"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- Kolory i wygląd przycisków -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292D36"/>
            <Setter Property="Foreground" Value="#F1F3F5"/>
            <Setter Property="BorderBrush" Value="#3A404C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A414D"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#626C7C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#20242B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Główne przyciski -->
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3478F6"/>
            <Setter Property="BorderBrush" Value="#3478F6"/>
        </Style>

        <!-- Przycisk odtwarzania -->
        <Style x:Key="PlayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="19,10"/>
            <Setter Property="MinWidth" Value="125"/>
        </Style>

        <!-- Pola wyboru -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#292D36"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454C59"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#292D36"/>
                        <Setter Property="Padding" Value="8,6"/>

                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3478F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A414D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                            Background="#292D36"
                            BorderBrush="#454C59"
                            BorderThickness="1"
                            CornerRadius="6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                            Grid.Column="0"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            TextElement.Foreground="#FFFFFF"
                            RecognizesAccessKey="True"/>

                                <Path Grid.Column="1"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="#FFFFFF"
                              Width="8"
                              Height="4"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Grid>

                            <ToggleButton
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen,
                            Mode=TwoWay,
                            RelativeSource={RelativeSource TemplatedParent}}"
                        ClickMode="Press"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="0.01"/>

                            <Popup
                        Name="PART_Popup"
                        Placement="Bottom"
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        AllowsTransparency="True"
                        Focusable="False"
                        PopupAnimation="Fade">

                                <Border
                            Background="#292D36"
                            BorderBrush="#454C59"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer
                                SnapsToDevicePixels="True"
                                MaxHeight="300">
                                        <StackPanel
                                    IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F1F3F5"/>
            <Setter Property="Background" Value="#292D36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3478F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A414D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8DCE4"/>
        </Style>

        <!-- Uchwyty początku i końca zaznaczenia na osi czasu -->
        <Style x:Key="ClipTimelineHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="HandleBorder"
                                Background="#3478F6"
                                BorderBrush="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="HandleBorder" Property="Background" Value="#75A5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HandleBorder" Property="Background" Value="#5B93FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E98A9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="180"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*" MinHeight="170"/>
        </Grid.RowDefinitions>

        <!-- GŁÓWNE MENU -->
        <Menu Grid.Row="0"
              Background="#1B1E25"
              Foreground="#F1F3F5"
              Padding="4,3"
              Margin="0,0,0,10">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#F1F3F5"/>
                    <Setter Property="Background" Value="#1B1E25"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="MinWidth" Value="150"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#3478F6"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#454C59"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="Plik">
                <MenuItem Header="Otwórz film…" Click="Open_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="Zakończ" Click="ExitMenu_Click"/>
            </MenuItem>
            <MenuItem Header="Pomoc">
                <MenuItem Header="Podstawowe funkcje programu" Click="BasicHelp_Click"/>
                <MenuItem Header="Informacje o programie" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- OBSZAR WIDEO -->
        <Border Grid.Row="1"
                Background="#050608"
                BorderBrush="#303541"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True"
                Margin="0,0,0,12">

            <Grid>
                <wfi:WindowsFormsHost x:Name="VideoHost"
                                      Background="#050608"/>

                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Background="#B8000000"
                        CornerRadius="0,0,8,0"
                        Padding="12,7"
                        IsHitTestVisible="False">
                    <TextBlock Text="VIDEO PLAYER"
                               Foreground="#DDE5F5"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>

            </Grid>
        </Border>

        <!-- REGULACJA WYSOKOŚCI OBSZARU WIDEO -->
        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#343B48"
                      ShowsPreview="True"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      ToolTip="Przeciągnij, aby zmienić wysokość okna nagrania"/>

        <!-- PANEL STEROWANIA -->
        <Border Grid.Row="3"
                Background="#1B1E25"
                BorderBrush="#303541"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">

            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- SKALOWANIE OBRAZU: poza obszarem WindowsFormsHost, który zasłania kontrolki WPF umieszczone nad nim -->
                <Border Background="#252A34"
                        BorderBrush="#3B4351"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10,7"
                        Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Skalowanie obrazu:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#D8DCE4"/>
                        <ComboBox x:Name="VideoScaleBox"
                                  Width="205"
                                  Height="32"
                                  FontSize="12"
                                  SelectedIndex="0"
                                  SelectionChanged="VideoScaleBox_SelectionChanged"
                                  ToolTip="Dopasuj obraz, wypełnij okno lub ustaw powiększenie">
                            <ComboBoxItem Content="Dopasuj cały obraz" Tag="fit"/>
                            <ComboBoxItem Content="Wypełnij okno" Tag="fill"/>
                            <ComboBoxItem Content="Powiększenie 125%" Tag="1.25"/>
                            <ComboBoxItem Content="Powiększenie 150%" Tag="1.5"/>
                            <ComboBoxItem Content="Powiększenie 200%" Tag="2"/>
                        </ComboBox>
                    </DockPanel>
                </Border>

                <!-- OŚ CZASU -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="76"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PositionText"
                               Grid.Column="0"
                               Text="00:00:00"
                               FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" Margin="10,0">
                        <Slider x:Name="PositionSlider"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                IsEnabled="False"
                                IsSelectionRangeEnabled="False"
                                SelectionStart="0"
                                SelectionEnd="0"
                                SmallChange="1"
                                LargeChange="10"
                                Height="30"
                                VerticalAlignment="Center"
                                ValueChanged="PositionSlider_ValueChanged"
                                Thumb.DragStarted="PositionSlider_DragStarted"
                                Thumb.DragCompleted="PositionSlider_DragCompleted"/>

                        <!-- Zaznaczenie i uchwyty są niezależne od suwaka pozycji filmu. -->
                        <Canvas x:Name="TimelineOverlay"
                                Margin="10,0"
                                VerticalAlignment="Stretch"
                                SizeChanged="TimelineOverlay_SizeChanged">
                            <Rectangle x:Name="ClipSelectionRect"
                                       Height="8"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Fill="#803478F6"
                                       Stroke="#FF3478F6"
                                       StrokeThickness="1"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <Thumb x:Name="ClipStartHandle"
                                   Style="{StaticResource ClipTimelineHandleStyle}"
                                   Canvas.Top="3"
                                   Visibility="Collapsed"
                                   DragDelta="ClipStartHandle_DragDelta"
                                   DragCompleted="ClipHandle_DragCompleted"/>
                            <Thumb x:Name="ClipEndHandle"
                                   Style="{StaticResource ClipTimelineHandleStyle}"
                                   Canvas.Top="3"
                                   Visibility="Collapsed"
                                   DragDelta="ClipEndHandle_DragDelta"
                                   DragCompleted="ClipHandle_DragCompleted"/>
                        </Canvas>
                    </Grid>

                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               Text="00:00:00"
                               FontFamily="Consolas"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ZNACZNIKI ZDARZEŃ -->
                <Border Background="#20242C" BorderBrush="#343B48" BorderThickness="1"
                        CornerRadius="6" Padding="9" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PUNKTY ZDARZEŃ NA OSI CZASU"
                                   Foreground="#DDE5F5" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <WrapPanel>
                            <TextBox x:Name="MarkerDescriptionBox" Width="280" Margin="0,0,8,8"
                                     Padding="7,5" Background="#171A20" Foreground="#E6EAF0"
                                     BorderBrush="#454C59"
                                     ToolTip="Opis zdarzenia, np. Wejście osoby lub Otwarcie bramy"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="＋ Dodaj w bieżącej pozycji" Click="AddMarker_Click" Margin="0,0,8,8"/>
                            <Button Content="Zmień opis" Click="UpdateMarker_Click" Margin="0,0,8,8"/>
                            <Button Content="Przejdź do" Click="GoToMarker_Click" Margin="0,0,8,8"/>
                            <Button Content="Usuń" Click="DeleteMarker_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <ListBox x:Name="TimelineMarkersListBox" Height="78"
                                 Background="#171A20" Foreground="#E6EAF0"
                                 BorderBrush="#343B48"
                                 SelectionChanged="TimelineMarkersListBox_SelectionChanged"
                                 ToolTip="Dwuklik na zdarzeniu, aby przejść do jego czasu">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="MouseDoubleClick" Handler="MarkerListItem_DoubleClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- ODTWARZANIE -->
                <TextBlock Text="ODTWARZANIE"
                           Style="{StaticResource SectionLabel}"/>

                <WrapPanel>
                    <Button Content="＋ Otwórz film"
                            Style="{StaticResource PrimaryButton}"
                            Click="Open_Click"/>

                    <Button x:Name="PlayButton"
                            Content="▶  Odtwarzaj / Pauza"
                            Style="{StaticResource PlayButtonStyle}"
                            Click="PlayPause_Click"/>

                    <Button Content="◀  Poprzednia klatka"
                            Click="PreviousFrame_Click"/>

                    <Button Content="Następna klatka  ▶"
                            Click="NextFrame_Click"/>

                    <Button x:Name="ScreenshotButton"
                            Content="▣  Zapisz klatkę JPG"
                            Click="Screenshot_Click"/>

                    <TextBlock Text="Prędkość"
                               Foreground="#9CA6B6"
                               VerticalAlignment="Center"
                               Margin="8,0,10,8"/>

                    <ComboBox x:Name="SpeedBox"
                              Width="100"
                              Margin="0,0,0,8"
                              SelectedIndex="2"
                              SelectionChanged="Speed_Changed">

                        <ComboBoxItem Content="0,25×" Tag="0.25"/>
                        <ComboBoxItem Content="0,5×" Tag="0.5"/>
                        <ComboBoxItem Content="1×" Tag="1"/>
                        <ComboBoxItem Content="2×" Tag="2"/>
                        <ComboBoxItem Content="4×" Tag="4"/>
                        <ComboBoxItem Content="8×" Tag="8"/>
                        <ComboBoxItem Content="16×" Tag="16"/>
                        <ComboBoxItem Content="32×" Tag="32"/>
                    </ComboBox>
                </WrapPanel>

                <Separator Background="#343945"
                           Margin="0,5,0,14"
                           Height="1"/>

                <!-- WYCIĘCIE FRAGMENTU -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="WYCIĘCIE FRAGMENTU"
                                   Style="{StaticResource SectionLabel}"/>

                        <WrapPanel>
                            <Button Content="⚑  Ustaw początek"
                                    Click="MarkStart_Click"/>

                            <Button Content="⚑  Ustaw koniec"
                                    Click="MarkEnd_Click"/>

                            <Button x:Name="ExportClipButton"
                                    Content="✂  Zapisz fragment MP4"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ExportClip_Click"/>

                            <TextBlock Text="Profil:" VerticalAlignment="Center" Foreground="#9CA6B6" Margin="10,0,6,8"/>
                            <ComboBox x:Name="ExportProfileBox" Width="175" Margin="0,0,8,8" SelectedIndex="1"
                                      ToolTip="Wybierz kompromis między szybkością, jakością i rozmiarem">
                                <ComboBoxItem Content="Szybki eksport" Tag="fast"/>
                                <ComboBoxItem Content="Standardowy" Tag="standard"/>
                                <ComboBoxItem Content="Mniejszy plik" Tag="small"/>
                                <ComboBoxItem Content="Wysoka jakość" Tag="quality"/>
                            </ComboBox>
                            <CheckBox x:Name="StreamCopyCheckBox" Content="Bez ponownego kodowania (szybko)"
                                      Foreground="#D8DCE4" VerticalAlignment="Center" Margin="0,0,8,8"
                                      ToolTip="Kopiuje strumienie bez kodowania. Cięcie może wypaść na najbliższej klatce kluczowej; kodeki muszą być zgodne z MP4."/>

                            <Button x:Name="RemoveClipButton"
                                    Content="✂ Usuń zaznaczony fragment"
                                    Click="RemoveClip_Click"
                                    Margin="8,0,0,0"
                                    Padding="12,8"
                                    Background="#8F3038"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Tworzy nowe nagranie bez zaznaczonego fragmentu"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#252A34"
                            BorderBrush="#3B4351"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,9"
                            Margin="10,0,0,8"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="ZAZNACZONY ZAKRES"
                                       Foreground="#8E98A9"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="ClipRangeText"
                                       Text="Nie zaznaczono fragmentu."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxWidth="260"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- POSTĘP EKSPORTU -->
                <Grid Margin="0,4,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ExportProgressText"
                   Grid.Column="0"
                   Text="Gotowy do eksportu"
                   Foreground="#9CA6B6"
                   FontSize="11"
                   VerticalAlignment="Center"/>

                        <Button x:Name="CancelExportButton"
                Grid.Column="1"
                Content="✕ Anuluj eksport"
                Padding="10,5"
                Margin="8,0,0,0"
                Visibility="Collapsed"
                IsEnabled="False"
                Click="CancelExport_Click"/>
                    </Grid>

                    <ProgressBar x:Name="ExportProgressBar"
                 Grid.Row="1"
                 Minimum="0"
                 Maximum="100"
                 Value="0"
                 Height="7"
                 Background="#303541"
                 Foreground="#3478F6"
                 BorderThickness="0"/>
                    <TextBlock x:Name="ExportOperationText"
                               Grid.Row="2"
                               Text="Brak aktywnej operacji"
                               Foreground="#7F899A"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </Grid>

                <Separator Background="#343945"
                           Margin="0,7,0,10"
                           Height="1"/>


                <Border Background="#20242C" BorderBrush="#343B48" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SESJA I WIDOK" Style="{StaticResource SectionLabel}"/>
                        <WrapPanel>
                            <Button Content="Reset widoku (R)" Click="ResetView_Click"/>
                            <Button Content="Zapisz sesję" Click="SaveSession_Click"/>
                            <Button Content="Uruchom ponownie mpv" Click="RestartMpv_Click"/>
                            <CheckBox x:Name="RestoreSessionCheckBox" Content="Przywracaj pozycję i widok" IsChecked="True" Foreground="#D8DCE4" VerticalAlignment="Center" Margin="8,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Text="Kółko nad filmem: zoom wokół kursora. Lewy przycisk: przesuń obraz. Spacja: pauza; ←/→: klatki; I/O: zakres; S: JPG; Ctrl+O: otwórz." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="LISTA FRAGMENTÓW" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Zatrzymaj film, ustaw początek, przejdź dalej, ustaw koniec, a potem dodaj zaznaczenie." TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="Początek (I)" Click="MarkStart_Click"/>
                            <Button Content="Koniec (O)" Click="MarkEnd_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="RangeFeedbackText" TextWrapping="Wrap" Foreground="#F5C970" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <TextBox x:Name="ClipNameBox" Width="220" Margin="0,0,8,8" Padding="7" Text="Fragment" ToolTip="Nazwa fragmentu"/>
                            <Button Content="Dodaj zaznaczenie" Click="AddRange_Click"/>
                            <Button Content="Zaktualizuj wybrany" Click="UpdateRange_Click"/>
                            <Button Content="Wczytaj zakres" Click="LoadRange_Click"/>
                            <Button Content="Usuń z listy" Click="DeleteRange_Click"/>
                            <Button x:Name="ExportAllButton" Content="Eksportuj wszystkie" Click="ExportAll_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="ClipRangesListBox" Height="90" Background="#171A20" Foreground="#E6EAF0" BorderBrush="#343B48" Margin="0,0,0,10"/>
                        <TextBlock Text="RAPORT ZDARZEŃ" Style="{StaticResource SectionLabel}"/>
                        <WrapPanel>
                            <Button x:Name="CsvReportButton" Content="Raport CSV" Click="CsvReport_Click"/>
                            <Button x:Name="PdfReportButton" Content="Raport PDF" Click="PdfReport_Click"/>
                            <CheckBox x:Name="ReportThumbnailsCheckBox" Content="Miniatury w PDF" IsChecked="True" Foreground="#D8DCE4" VerticalAlignment="Center" Margin="8,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- INFORMACJE O PLIKU + HISTORIA -->
                <Border Background="#20242C"
                        BorderBrush="#343B48"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="INFORMACJE O NAGRANIU I PRZEWIDYWANY ROZMIAR"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="MediaInfoText"
                                   Text="Otwórz nagranie, aby odczytać kodek, rozdzielczość, FPS, bitrate i rozmiar."
                                   Foreground="#D8DCE4"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="Ostatnie nagrania:" VerticalAlignment="Center" Foreground="#9CA6B6" Margin="0,0,8,8"/>
                            <ComboBox x:Name="RecentFilesBox" Width="260" Margin="0,0,8,8" ToolTip="Ostatnio otwierane nagrania"/>
                            <Button Content="Otwórz wybrane" Click="OpenRecent_Click"/>
                            <TextBlock Text="Zrzuty JPG:" VerticalAlignment="Center" Foreground="#9CA6B6" Margin="8,0,8,8"/>
                            <ComboBox x:Name="ScreenshotsBox" Width="220" Margin="0,0,8,8" ToolTip="Ostatnio zapisane zrzuty klatek"/>
                            <Button Content="Pokaż zrzut" Click="OpenScreenshot_Click"/>
                            <Button Content="Folder zrzutów" Click="OpenScreenshotsFolder_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- STATUS -->
                <DockPanel LastChildFill="True">
                    <Ellipse x:Name="StatusIndicator"
                             DockPanel.Dock="Left"
                             Width="7"
                             Height="7"
                             Fill="#687386"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="StatusText"
                               Text="Uruchamianie odtwarzacza…"
                               Foreground="#9CA6B6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="VideoPlayer - Autor: Rafał Bonna (2026)"
                               Foreground="#555555"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               Margin="0,10,0,0"/>      

                </DockPanel>

            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
