<Window x:Class="VideoPlayer.DahuaConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfiguracja urządzeń Dahua" Width="900" Height="620"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="#0F1724" Foreground="#F8FAFC" FontFamily="Segoe UI">
    <Window.Resources>

        <!-- Jednoznaczny kontrast zaznaczonego urządzenia w liście. -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BFDBFE"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202B3B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52647D"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#202B3B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52647D"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#26364C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52647D"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="KONFIGURACJA KAMER I REJESTRATORÓW" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Zarządzanie urządzeniami jest oddzielone od codziennego podglądu." Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#172235" BorderBrush="#34465F" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,12,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="＋ Dodaj urządzenie" Click="Add_Click" Margin="0,8,0,0"/>
                    <ListBox x:Name="DevicesList" Background="#101A2A" Foreground="#FFFFFF" BorderBrush="#42546D"
                             SelectionChanged="DevicesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="10" Foreground="#94A3B8"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#172235" BorderBrush="#34465F" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DANE URZĄDZENIA" FontSize="13" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>
                        <TextBlock Text="Nazwa wyświetlana" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Adres IP / host" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AddressBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Port NetSDK" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PortBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port HTTP" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="HttpPortBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Użytkownik" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameBox"/>
                        <TextBlock Text="Hasło" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox"/>
                        <TextBlock x:Name="CredentialInfo" Text="Dane logowania są szyfrowane przez Windows DPAPI (CurrentUser)."
                                   Foreground="#86EFAC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="💾 Zapisz zmiany" Click="Save_Click" Background="#1D4ED8"/>
                            <Button Content="🗑 Usuń urządzenie" Click="Delete_Click" Background="#991B1B"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Konfiguracja jest zapisywana w profilu użytkownika Windows." Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Zamknij" Click="Close_Click" Margin="8,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>