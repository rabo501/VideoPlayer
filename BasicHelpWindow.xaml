<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VideoPlayer.BasicHelpWindow" Title="Obsługa VideoPlayer 1.2" Width="670" Height="580" MinWidth="480" MinHeight="350" WindowStartupLocation="CenterOwner" Background="#20242C" Foreground="#E6EAF0">
    <DockPanel Margin="20">
        <Button DockPanel.Dock="Bottom" Content="Zamknij" Click="Close_Click" HorizontalAlignment="Right" Padding="20,7" Margin="0,12,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="VideoPlayer — nowy układ" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock TextWrapping="Wrap" Text="Podgląd jest po lewej. Oś czasu i przyciski odtwarzania pozostają na dole, niezależnie od wybranej zakładki. Prawy panel zmienia szerokość po przeciągnięciu separatora; można go ukryć przyciskiem u góry albo w menu Widok." Margin="0,0,0,16" />
                <TextBlock Text="Fragmenty" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="Zatrzymaj film, ustaw początek, przejdź do późniejszej pozycji i ustaw koniec. Wpisz nazwę i dodaj zaznaczenie. Na liście można wczytywać, aktualizować i usuwać zakresy." Margin="0,4,0,12" />
                <TextBlock Text="Zdarzenia" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="Wpisz opis i dodaj zdarzenie. Dwuklik na pozycji przenosi do zdarzenia. Tu są również raporty CSV i PDF." Margin="0,4,0,12" />
                <TextBlock Text="Eksport" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="Wybierz profil i zapisz zaznaczenie albo wszystkie nazwane fragmenty. Możesz też utworzyć film bez zaznaczenia. Oryginał pozostaje bez zmian. Postęp i anulowanie są zawsze na dole." Margin="0,4,0,12" />
                <TextBlock Text="Pliki" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="Historia nagrań, zapisane klatki, informacje o filmie i opcje sesji. Skalowanie i reset są też w menu Widok; restart mpv jest w menu Pomoc." Margin="0,4,0,12" />
                <TextBlock Text="Skróty i mysz" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="Spacja: Play/pauza. Strzałki: pojedyncze klatki. I/O: początek/koniec. S: klatka JPG. Ctrl+O: otwórz. R: reset widoku. Kółko: zoom. Lewy przycisk: przesuwanie. Prawy przycisk: menu obrazu. Zwykłe skróty są wyłączone w polach tekstowych." Margin="0,4,0,12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>