<Window x:Class="VideoPlayer.PlateOcrWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Rozpoznawanie tablicy — bez internetu" Width="1060" Height="760" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F3F5F8" Foreground="#172033" Closing="Window_Closing">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10"><TextBlock x:Name="FrameInfo" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Przeciągnij myszą po tablicy. Zaznacz same znaki z niewielkim marginesem, bez niebieskiego paska PL." TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="To pełna klatka nagrania — niezależna od powiększenia i przesunięcia w odtwarzaczu." Foreground="#58647A" Margin="0,4,0,0"/></StackPanel>
  <Grid x:Name="PictureArea" Grid.Row="1" Background="#111318" ClipToBounds="True" Cursor="Cross" MouseLeftButtonDown="Picture_Down" MouseMove="Picture_Move" MouseLeftButtonUp="Picture_Up" SizeChanged="Picture_SizeChanged">
   <Image x:Name="FrameImage" Stretch="Uniform" IsHitTestVisible="False"/>
   <Canvas IsHitTestVisible="False"><Rectangle x:Name="SelectionBox" Stroke="#21CFFF" StrokeThickness="2" Fill="#3321CFFF" Visibility="Collapsed"/></Canvas>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <DockPanel><Button x:Name="RecognizeButton" Content="Rozpoznaj zaznaczoną tablicę" Click="Recognize_Click" Padding="12,8" IsEnabled="False" DockPanel.Dock="Left"/><TextBlock x:Name="SelectionInfo" Text="Najpierw zaznacz tablicę na obrazie." VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></DockPanel>
   <TextBlock x:Name="OcrStatus" Text="Silnik OCR działa lokalnie. Wynik wymaga sprawdzenia — szczególnie O/0, I/1 i B/8." Margin="0,9,0,6" TextWrapping="Wrap"/>
   <DockPanel><TextBlock Text="Numer tablicy:" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="PlateBox" FontSize="23" FontWeight="SemiBold" MaxLength="24" Padding="8,5" CharacterCasing="Upper" TextChanged="Plate_Changed"/></DockPanel>
   <WrapPanel Margin="0,7,0,0"><TextBlock Text="Inne propozycje:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="CandidatesBox" Width="210" SelectionChanged="Candidate_Changed"/></WrapPanel>
   <CheckBox x:Name="ConfirmedBox" Content="Sprawdzam obraz i potwierdzam poprawność wpisanego numeru." Margin="0,10,0,8" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Anuluj" Click="Cancel_Click" Padding="15,8" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Zapisz jako zdarzenie" Click="Save_Click" Padding="15,8" IsEnabled="False"/></StackPanel><TextBlock Text="Nagranie pozostanie zatrzymane. Zamknięcie okna nie zapisuje odczytu." Foreground="#58647A" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
