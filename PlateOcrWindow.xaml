<Window x:Class="VideoPlayer.PlateOcrWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Rozpoznawanie tablicy — bez internetu" Width="1120" Height="850" MinWidth="640" MinHeight="620" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F3F5F8" Foreground="#172033" Closing="Window_Closing">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10"><TextBlock x:Name="FrameInfo" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Zaznacz obszar przeciągnięciem, a następnie przesuń niezależnie każdy z czterech narożników. Możesz uformować dowolny wypukły czworokąt, np. trapez lub nieregularny kształt perspektywiczny." TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Obejmij same znaki z małym marginesem, bez ramki i paska PL. Zmieniaj rozmiar okna — podgląd dopasuje się do dostępnego miejsca. Kółko: zoom pod kursorem. Prawy przycisk i przeciąganie: przesuwanie. Lewy: zaznaczenie i narożniki." Foreground="#58647A" Margin="0,4,0,0"/><WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
    <TextBlock Text="Powiększenie:" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Button Content="−" Click="ZoomOut_Click" Width="35" Padding="4" Margin="0,0,4,0" ToolTip="Pomniejsz widok klatki"/>
    <TextBlock x:Name="ZoomLabel" Text="1×" Width="55" TextAlignment="Center" VerticalAlignment="Center"/>
    <Button Content="+" Click="ZoomIn_Click" Width="35" Padding="4" Margin="4,0,8,0" ToolTip="Powiększ widok klatki"/>
    <Button Content="Dopasuj" Click="FitView_Click" Padding="10,4" ToolTip="Pokaż całą klatkę, zachowując zaznaczone narożniki"/>
   </WrapPanel></StackPanel>
  <Grid x:Name="PictureArea" Grid.Row="1" Background="#111318" ClipToBounds="True" Cursor="Cross" MouseLeftButtonDown="Picture_Down" MouseMove="Picture_Move" MouseLeftButtonUp="Picture_Up" SizeChanged="Picture_SizeChanged" LostMouseCapture="Picture_LostCapture" PreviewMouseWheel="Picture_Wheel" MouseRightButtonDown="Picture_PanDown" MouseRightButtonUp="Picture_PanUp">
   <Canvas IsHitTestVisible="False"><Image x:Name="FrameImage" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/></Canvas>
   <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
    <Polygon x:Name="SelectionPolygon" Stroke="#21CFFF" StrokeThickness="2" Fill="#2221CFFF" Visibility="Collapsed"/>
   </Canvas>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <Border Background="#18202B" Padding="8" Margin="0,0,0,8"><StackPanel><TextBlock Text="Wycinek po prostowaniu — przed filtrami OCR" Foreground="White" Margin="0,0,0,4"/><Image x:Name="RectifiedPreview" Height="76" Stretch="Uniform"/></StackPanel></Border>
   <DockPanel><Button x:Name="ResetSelectionButton" Content="Nowe zaznaczenie" Click="ResetSelection_Click" Padding="10,8" Margin="0,0,8,0" DockPanel.Dock="Right"/><Button x:Name="RecognizeButton" Content="Rozpoznaj zaznaczoną tablicę" Click="Recognize_Click" Padding="12,8" IsEnabled="False" DockPanel.Dock="Left"/><TextBlock x:Name="SelectionInfo" Text="Najpierw zaznacz tablicę na obrazie." VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></DockPanel>
   <TextBlock x:Name="OcrStatus" Text="Silnik OCR działa lokalnie. Wynik wymaga sprawdzenia — szczególnie O/0, I/1 i B/8." Margin="0,9,0,6" TextWrapping="Wrap"/>
   <DockPanel><TextBlock Text="Numer tablicy:" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="PlateBox" FontSize="23" FontWeight="SemiBold" MaxLength="24" Padding="8,5" CharacterCasing="Upper" TextChanged="Plate_Changed"/></DockPanel>
   <DockPanel Margin="0,7,0,0"><TextBlock Text="Marka pojazdu:" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="VehicleMakeBox" FontSize="16" MaxLength="60" Padding="8,5" ToolTip="Wpisz ręcznie markę pojazdu, np. Toyota, Volkswagen, BMW."/></DockPanel>
   <WrapPanel Margin="0,7,0,0"><TextBlock Text="Inne propozycje:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="CandidatesBox" Width="210" SelectionChanged="Candidate_Changed"/></WrapPanel>
   <CheckBox x:Name="ConfirmedBox" Content="Sprawdzam obraz i potwierdzam poprawność wpisanego numeru." Margin="0,10,0,8" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Anuluj" Click="Cancel_Click" Padding="15,8" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Zapisz jako zdarzenie" Click="Save_Click" Padding="15,8" IsEnabled="False"/></StackPanel><TextBlock Text="Nagranie pozostanie zatrzymane. Zamknięcie okna nie zapisuje odczytu." Foreground="#58647A" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
