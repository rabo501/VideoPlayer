<Window x:Class="VideoPlayer.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Informacje o programie" Width="650" Height="560" MinWidth="590" MinHeight="510" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#151922" Foreground="#EDF1F7" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#3478F6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3478F6"/><Setter Property="Padding" Value="18,8"/><Setter Property="MinWidth" Value="92"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#9BA8BA"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="#B9C9E2"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#202A3A" BorderBrush="#34445D" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="62" Height="62" CornerRadius="15" Background="#3478F6" VerticalAlignment="Center"><Viewbox Margin="15"><Path Data="M 0,0 L 30,18 L 0,36 Z" Fill="White"/></Viewbox></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="VideoPlayer" FontSize="25" FontWeight="SemiBold" Foreground="White"/>
     <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="VersionText" Text="Wersja" Foreground="#8FB5FF" FontWeight="SemiBold"/><TextBlock Text="   •   Aplikacja do analizy nagrań wideo" Style="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="O PROGRAMIE" Style="{StaticResource Section}"/>
   <TextBlock Text="VideoPlayer to narzędzie wspomagające przeglądanie i analizę nagrań monitoringu. Umożliwia odtwarzanie klatka po klatce, oznaczanie zdarzeń, wyznaczanie fragmentów, odczyt tablic oraz przygotowywanie eksportów i raportów." TextWrapping="Wrap" Foreground="#D5DCE7" LineHeight="20" Margin="0,0,0,18"/>
   <Border Background="#1D2430" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="INFORMACJE O WYDANIU" Style="{StaticResource Section}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Autor" Style="{StaticResource Muted}" Margin="0,4"/><TextBlock Grid.Column="1" Text="Rafał Bonna" FontWeight="SemiBold" Margin="0,4"/>
     <TextBlock Grid.Row="1" Text="Wydanie" Style="{StaticResource Muted}" Margin="0,4"/><TextBlock x:Name="ProductVersionText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,4"/>
     <TextBlock Grid.Row="2" Text="Architektura" Style="{StaticResource Muted}" Margin="0,4"/><TextBlock x:Name="ArchitectureText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,4"/>
    </Grid>
   </StackPanel></Border>
   <Border Background="#1D2430" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="WYKORZYSTANE KOMPONENTY" Style="{StaticResource Section}"/>
    <TextBlock Text="mpv  •  FFmpeg  •  Tesseract OCR  •  SQLite  •  PDFsharp" Foreground="#E3EAF4" TextWrapping="Wrap"/>
    <TextBlock Text="Komponenty zewnętrzne są rozwijane i licencjonowane przez ich autorów. Szczegóły licencji znajdują się w dokumentacji i plikach dystrybucyjnych poszczególnych bibliotek." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
   </StackPanel></Border>
   <StackPanel><TextBlock Text="PROJEKT I ŹRÓDŁA" Style="{StaticResource Section}"/><TextBlock Text="Kod źródłowy i informacje o projekcie:" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
    <TextBlock><Hyperlink NavigateUri="https://github.com/rabo501/VideoPlayer" RequestNavigate="ProjectLink_RequestNavigate" Foreground="#8FB5FF">github.com/rabo501/VideoPlayer</Hyperlink></TextBlock>
   </StackPanel>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="© " Style="{StaticResource Muted}"/><TextBlock x:Name="CopyrightYearText" Text="2026" Style="{StaticResource Muted}"/><TextBlock Text="  Rafał Bonna" Style="{StaticResource Muted}"/></StackPanel><Button DockPanel.Dock="Right" Content="Zamknij" IsDefault="True" Click="Close_Click"/></DockPanel>
 </Grid>
</Window>